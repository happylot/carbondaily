# ============================================================
# CARBON MARKET INTELLIGENCE PIPELINE — Biến môi trường
# Sao chép file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git
# ============================================================

# --- AI Provider ---
# Chọn provider: 'openai' hoặc 'bedrock' (mặc định: openai)
AI_PROVIDER=openai

# --- OpenAI API (dùng khi AI_PROVIDER=openai) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# Model mặc định: gpt-4o. Có thể đổi sang gpt-4o-mini để tiết kiệm chi phí
OPENAI_MODEL=gpt-4o

# --- Amazon Bedrock (dùng khi AI_PROVIDER=bedrock) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chỉ cần khi dùng STS temporary credentials (AssumeRole):
# AWS_SESSION_TOKEN=

# Model ID trên Bedrock. Mặc định: Claude 3.5 Sonnet v2
# Các lựa chọn phổ biến:
#   anthropic.claude-3-5-sonnet-20241022-v2:0   ← khuyến nghị (tốt nhất cho tiếng Việt)
#   anthropic.claude-3-5-haiku-20241022-v1:0    ← rẻ hơn ~4x, đủ dùng
#   amazon.nova-pro-v1:0                         ← Amazon Nova Pro (rẻ nhất)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Gmail (nodemailer + OAuth2 hoặc App Password) ---
# Dùng Gmail App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=phuc189@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Người nhận ---
REPORT_TO=xoan.vu@stavianmetal.com
REPORT_CC=
# Nhiều địa chỉ phân cách bằng dấu phẩy

# --- Telegram ---
TELEGRAM_BOT_TOKEN=xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# --- Cấu hình pipeline ---
# Múi giờ (mặc định Asia/Ho_Chi_Minh)
TZ=Asia/Ho_Chi_Minh

# Ngưỡng cảnh báo thay đổi giá (%) để đánh dấu breaking news
PRICE_ALERT_THRESHOLD=3

# --- Giá EUA nhập tay (ICE) ---
# Yahoo/proxy KRBN KHÔNG cho giá EUA thật (chỉ ~34 USD, phản ánh xu hướng).
# Đặt giá ICE thật mỗi sáng để báo cáo hiển thị đúng (đơn vị €/tCO2).
# EUA_PRICE_OVERRIDE=76.55
# (tuỳ chọn) giá đóng cửa phiên trước để tính Δ ngày chính xác:
# EUA_PREVCLOSE_OVERRIDE=76.96

# --- Nguồn tin & kiểm tra link ---
# Carbon Pulse chặn Cloudflare + yêu cầu thuê bao: trang bài trả HTTP 403 nên
# link không được dùng làm nguồn dẫn. Nếu đã mua thuê bao, dán cookie đăng nhập
# vào đây — cookie sẽ được gửi kèm khi tải feed và khi kiểm tra link.
# CARBON_PULSE_COOKIE=wordpress_logged_in_xxx=...; wp-settings-1=...

# Bỏ qua bước kiểm tra link (chỉ dùng khi debug — báo cáo có thể chứa link hỏng):
# SKIP_LINK_CHECK=1
# Giữ lại cả bài không mở được (kèm cờ citable/linkStatus) thay vì loại bỏ:
# KEEP_UNCITABLE=1

# Thư mục output HTML
OUTPUT_DIR=../Reports

# --- Internal alert (khi pipeline lỗi) ---
ALERT_EMAIL=phuc189@gmail.com
